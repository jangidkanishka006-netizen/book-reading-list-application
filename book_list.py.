
# Book Reading List Application

books = []


def add_book():
    title = input("Enter book title: ").strip()
    author = input("Enter author name: ").strip()

    if not title or not author:
        print("Book title and author cannot be empty.")
        return

    book = {
        "title": title,
        "author": author,
        "status": "To Read"
    }

    books.append(book)
    print("Book added successfully!")


def view_books():
    if not books:
        print("Your reading list is empty.")
        return

    print("\n--- My Reading List ---")

    for number, book in enumerate(books, start=1):
        print(f"{number}. {book['title']} by {book['author']}")
        print(f"   Status: {book['status']}")


def mark_as_read():
    view_books()

    if not books:
        return

    try:
        number = int(input("Enter book number to mark as read: "))

        if 1 <= number <= len(books):
            books[number - 1]["status"] = "Read"
            print("Book marked as read!")
        else:
            print("Invalid book number.")

    except ValueError:
        print("Please enter a valid number.")


while True:
    print("\n=== BOOK READING LIST ===")
    print("1. Add a book")
    print("2. View books")
    print("3. Mark a book as read")
    print("4. Exit")

    choice = input("Choose an option: ").strip()

    if choice == "1":
        add_book()
    elif choice == "2":
        view_books()
    elif choice == "3":
        mark_as_read()
    elif choice == "4":
        print("Happy reading! Goodbye.")
        break
    else:
        print("Invalid choice. Please try again.")
